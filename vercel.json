{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/command",
      "dest": "/api/command.js"
    },
    {
      "src": "/api/latest-command",
      "dest": "/api/latest-command.js"
    },
    {
      "src": "/api/command-status",
      "dest": "/api/command-status.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1",
      "check": true
    }
  ]
}
