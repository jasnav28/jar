{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "runtime": "vercel-node@latest"
    }
  },
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1",
      "check": true
    }
  ]
}
