{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/command",
      "destination": "/api/command.js"
    },
    {
      "source": "/api/latest-command",
      "destination": "/api/latest-command.js"
    },
    {
      "source": "/api/command-status",
      "destination": "/api/command-status.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
